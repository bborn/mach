#!/usr/bin/env bash
set -euo pipefail
#
# USAGE-BEGIN
# scripts/qa — look at a running Mach instead of guessing.
#
#   qa up            launch YOUR instance (the real mailbox)
#   qa down          stop it
#   qa restart       rebuild and relaunch — what you want after a `git pull`
#   qa shoot NAME    screenshot the window -> .qa/<instance>/NAME.png
#   qa state         process, window, which checkout built it, accounts, rows
#   qa logs [n]      tail the log
#   qa key BINDING   press a key in the window: 'mod+2', 'g i', 'c', '?'
#   qa click CSS     click the first match: '[data-thread-id="41774"]'
#   qa menu CSS      right-click the first match — opens a context menu
#   qa type TEXT     put TEXT into whatever has the caret
#   qa press KEY     an editing key into the caret: Enter, Backspace, mod+Backspace
#   qa ui            what is on screen: mode, cursor, selection, overlay, rows
#   qa browser URL   open the in-app page window on a LOCAL fixture (loopback only)
#
# ---------------------------------------------------------------------------
# DRIVE THE REAL APP. NEVER TOUCH THE OWNER'S FOCUS.
# ---------------------------------------------------------------------------
#
# Someone is using this machine, and the whole design here follows from that.
#
#   `qa up` on an instance OTHER than `main` is safe. Those processes set an
#   Accessory activation policy and build their window unfocused (see
#   `src-tauri/src/shell.rs`), so they never appear in the Dock, never become
#   the active application, and cannot take a keystroke — while still being a
#   real window. `qa up` on `main` is the owner's own app and is off limits.
#
#   `qa shoot` is safe. It captures the window's own buffer by CGWindowID, so
#   the window is never raised — occluded, backgrounded, whatever.
#
#   `qa key`, `qa click`, `qa menu`, `qa type`, `qa press` and `qa ui` are safe
#   on a QA instance. They do not send OS input. They POST one of six fixed
#   verbs to a loopback port the app opens for QA instances in development
#   builds; the frontend synthesises the keystroke and hands it to the keymap,
#   or dispatches the click in the page. Focus never moves, because nothing
#   about this involves the window server. See `src-tauri/src/qa/` and
#   `src/lib/qa-bridge.ts`.
#
#   MACH_QA_INPUT=1 switches `key` and `click` back to real OS input, which
#   raises the window and takes the keyboard. It takes a cliclick spec
#   (`kp:return`, `t:hello`) and window-relative `X,Y` instead of a binding and
#   a selector. It exists for the rare thing the page cannot see — a native
#   menu, a system dialog — and you should have a reason.
#
#   It now refuses unless the target instance is already frontmost. A QA
#   instance runs under an Accessory policy and cannot be raised, so the raise
#   fails silently and the keystrokes land in whatever is. An agent typed a
#   sentence into the owner's real mailbox that way and archived a conversation
#   with it.
#
# So: the real app is the answer for anything native. A window edge, the
# traffic lights, a WebKit-only behaviour, a composer, a full-screen surface —
# launch a QA instance and drive it.
#
#   MACH_QA_INSTANCE=agent scripts/qa up
#   MACH_QA_INSTANCE=agent scripts/qa key 'mod+,'
#   MACH_QA_INSTANCE=agent scripts/qa shoot prefs
#   MACH_QA_INSTANCE=agent scripts/qa ui
#
# ---------------------------------------------------------------------------
# TEXT, AND THE DIFFERENCE BETWEEN A BINDING AND A CHARACTER
# ---------------------------------------------------------------------------
#
# `qa key` answers "what does this *binding* do". It hands a synthetic event to
# the keymap registry, which is the thing that decides what a key means — so a
# QA keystroke and a real one take the same code path, and `handled` tells you
# whether anything claimed it.
#
# It cannot put a character in a field, and it never could. The keymap is not
# the text editor; a `KeyboardEvent` the page constructs has no default action,
# so dispatching one at a composer edits nothing. Every composer bug in one week
# — Return, Backspace, ⌘⌫, autolinking, the address typeahead — lived in text
# input, and the port structurally could not reach any of it. They were found by
# driving Blink through CDP instead, which is not evidence about WebKit.
#
#   qa type 'hello there'      insert literal text at the caret
#   qa press Enter             an editing key, with the edit actually performed
#   qa press mod+Backspace     delete to the start of the line
#
# Both act on whatever has DOM focus and answer with what the field holds
# afterwards, so you can read back what landed rather than guessing:
#
#   MACH_QA_INSTANCE=agent scripts/qa key c              # open a composer
#   MACH_QA_INSTANCE=agent scripts/qa click '[aria-label="To"]'
#   MACH_QA_INSTANCE=agent scripts/qa type 'someone@example.com'
#   MACH_QA_INSTANCE=agent scripts/qa press Enter
#
# `qa menu` is the right-click. `qa click`'s sequence is pointerdown, mousedown,
# pointerup, mouseup, click — no `contextmenu`, so neither of the app's two
# context menus could be opened from the port at all.
#
# USAGE-END
#
# Headless Chrome against Vite is still there and is still right for pure
# component and logic work, where a second engine costs nothing. `webqa.ts`
# clicks, types, reads the DOM and screenshots with no window at all:
#
#   bun scripts/webqa.ts reload    # …and reports what the page load logged
#   bun scripts/webqa.ts eval '<javascript>'
#
# Use `reload` first when a page looks blank: it holds one CDP session across
# the navigation and prints the exceptions, which is the only way to see an
# error thrown before the app finished mounting. What it cannot tell you is
# anything about the app as a Mac application: it is Blink, in a tab, with no
# traffic lights, no overlay title bar and a different scrollbar engine. Four
# defects shipped verified that way.
#
# Real-data checks do not need the UI at all: `qa state` reads the database.
#
# ---------------------------------------------------------------------------
# INSTANCES
# ---------------------------------------------------------------------------
#
# `MACH_QA_INSTANCE=agent qa up` launches a SEPARATE app with its own SQLite
# store under .qa/agent/data, its own window, and its own log. Nothing it does
# touches the mailbox the owner is reading.
#
#   MACH_QA_INSTANCE=agent scripts/qa seed    # copy the real store once
#   MACH_QA_INSTANCE=agent scripts/qa up
#   MACH_QA_INSTANCE=agent scripts/qa shoot before
#
# `seed` copies the owner's database so the agent instance has realistic mail
# and calendars without doing its own backfill or spending API quota. It
# refuses to overwrite an existing seeded store unless you pass --force.
#
# It copies mail, not credentials. Refresh tokens are in the Keychain, and a
# non-main instance addresses its own service — com.mach.mail.oauth.qa-<name>
# rather than com.mach.mail.oauth — so it cannot read or write the owner's.
# A seeded instance therefore starts with accounts and no credentials: every
# address reports "needs reauthorization" and nothing reaches Google. That is
# the intended state, and it is what stops a QA instance putting a Keychain
# password dialog on the owner's screen. See `auth::tokens::keychain_service`.
#
# Every command targets one instance's pid, so two instances can run at once
# and `shoot` never captures the wrong window.
#
# ---------------------------------------------------------------------------
# EVERY INSTANCE SERVES ITS OWN FRONTEND. ONLY `main` MAY HAVE 1420.
# ---------------------------------------------------------------------------
#
# Port 1420 is where the owner's running app loads its frontend from. `qa up`
# used to start `bun run dev` from whatever checkout invoked it whenever nothing
# was listening there — so an agent in a worktree served *its* half-finished
# frontend into the window the owner was reading real mail in. It happened
# twice in one day.
#
# So the dev server port is derived from the instance and the checkout:
#
#   main              1420, and nothing else may take it
#   anything else     1430–1928, from a hash of "<repo>|<instance>"
#
# Bound with `--strictPort`, so vite either gets that exact port or dies —
# an instance can never end up attached to a server somebody else started.
# A taken port means the next candidate is tried, and the one that answers is
# recorded in .qa/<instance>/vite.json with the pid that owns it.
#
# The binary is told where to load from with MACH_DEV_URL, read at *runtime*
# (see `src-tauri/src/qa/dev.rs`). `devUrl` in tauri.conf.json is expanded by
# `generate_context!` at compile time, so pointing an instance somewhere else
# used to need `touch src-tauri/src/lib.rs` *and* `touch src-tauri/build.rs`
# before the binary would let go of the old port — and if you did neither, it
# silently loaded the wrong frontend. It is now a runtime value, and a QA
# instance that would load 1420 refuses to start rather than render into the
# owner's port by accident.
#
# Two guards you will meet if you get it wrong:
#
#   - `qa up` refuses to run `main` from a worktree. `main` is the owner's own
#     app on the owner's own port, and a worktree is by definition not it.
#   - The app exits with a message if MACH_DEV_URL is missing or points at
#     1420 while MACH_DATA_DIR is set.
#
# ---------------------------------------------------------------------------
#
# The binary runs directly rather than under `tauri dev`: the watcher rebuilds
# on every change, and each new unsigned binary re-prompts macOS for Keychain
# access. Vite still serves the frontend, so UI changes hot-reload into every
# running instance; only Rust changes need `down` && `up`.
#
# A worktree has no `src-tauri/target` of its own — `bin/worktree-setup` points
# cargo at the parent's cache so a ten-line change does not rebuild the world.
# `scripts/cargo-target-dir` is how this script and `scripts/sign` find the
# binary that cargo actually wrote; neither hardcodes `src-tauri/target` any
# more, and nobody has to symlink one in by hand.
#
# That shared cache has a second consequence, and it is the nastiest thing in
# this file: `debug/mach` is whatever compiled last, from whichever checkout.
# Launch it in place and you are running that. The owner spent a day reading
# real mail in a binary an agent had built in a worktree, from code that was
# never merged, and the only sign of it was one line in the log:
#
#     mach: built from …/.claude/worktrees/agent-a85e4779ab396da01/src-tauri
#
# So EVERY instance — `main` included — is launched from its own copy under
# .qa/<instance>/bin/mach, taken at `up` time from an artifact this checkout is
# verified to have built. Whatever anyone compiles afterwards, the bytes on
# screen are the bytes that were pinned. `qa state` reports what the running
# process says it was built from, and says when the shared artifact has moved
# on underneath the pin.
#
# ---------------------------------------------------------------------------
# `qa shoot` DOES NOT CAPTURE CONTEXT MENUS
# ---------------------------------------------------------------------------
#
# If ⇧F10 reports `handled: true` and `qa ui` reports an overlay but the
# screenshot shows no menu, your menu is not broken. The long comment above
# `cmd_shoot` lists the five explanations that have already been tested and
# ruled out, and what to assert on instead. Read it before spending the hour.

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTANCE="${MACH_QA_INSTANCE:-main}"
QA_DIR="$REPO/.qa/$INSTANCE"
PIDFILE="$QA_DIR/mach.pid"
LOG="$QA_DIR/mach.log"
# Per instance, not one shared file. Two agents tailing the same vite.log to
# find out why their own server would not start is how the last round of this
# went.
VITE_LOG="$QA_DIR/vite.log"
VITE_STATE="$QA_DIR/vite.json"
REAL_DB="$HOME/Library/Application Support/com.mach.mail/mach.sqlite3"

# `src-tauri/target` is a lie in a worktree; see `scripts/cargo-target-dir`.
TARGET_DIR="$("$REPO/scripts/cargo-target-dir" "$REPO")"
BIN="$TARGET_DIR/debug/mach"

# A git worktree has a `.git` *file* holding a gitdir pointer; a checkout has a
# directory. No git command needed, and none is run: this script is invoked by
# agents who are told not to touch git at all.
is_worktree() { [ -f "$REPO/.git" ]; }

# The owner's instance uses the OS app-data dir; every other instance is
# self-contained under .qa/<name>/data.
#
# The Keychain is the one thing that is global to the machine, so it is
# namespaced the same way: `auth::tokens::keychain_service` derives the service
# from MACH_DATA_DIR, and the value below is the same derivation so this script
# can say which namespace an instance is using. Only `main` names
# com.mach.mail.oauth, which is where the owner's refresh tokens are.
if [ "$INSTANCE" = "main" ]; then
  DATA_DIR=""
  DB="$REAL_DB"
  CONTROL=""
  KEYCHAIN_SERVICE="com.mach.mail.oauth"
  # The one instance that may have 1420, because it is the one the owner's
  # window loads from.
  VITE_PORT=1420
else
  DATA_DIR="$QA_DIR/data"
  DB="$DATA_DIR/mach.sqlite3"
  # Written 0600 by `qa::write_endpoint` when the app starts. The `main`
  # instance has no MACH_DATA_DIR, so it never opens a port and there is
  # nothing here to read.
  CONTROL="$DATA_DIR/qa-control.json"
  SLUG="$(printf '%s' "$INSTANCE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/^-*//; s/-*$//')"
  [ -n "$SLUG" ] || SLUG="unnamed"
  KEYCHAIN_SERVICE="com.mach.mail.oauth.qa-$SLUG"
  VITE_PORT=""   # decided by `ensure_vite`, and never 1420
fi

# Never `$BIN`. See `pin_binary`: the shared artifact is whoever built last, and
# `main` is not exempt from that — it was the one instance that ran it in place,
# and it is the one where being wrong costs the owner his day.
LAUNCH_BIN="$QA_DIR/bin/mach"

mkdir -p "$QA_DIR"

die() { echo "qa[$INSTANCE]: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# The dev server, one per instance
# ---------------------------------------------------------------------------

# 1430–1928, deterministic per checkout *and* instance.
#
# Per checkout matters: two agents in two worktrees both saying
# MACH_QA_INSTANCE=agent are the common case, and a port derived from the name
# alone would put them on the same one. Deterministic matters because an
# instance restarted an hour later should land back where it was rather than
# leaking a new port every time.
derived_port_base() {
  python3 - "$REPO" "$INSTANCE" <<'PY'
import hashlib, sys
seed = ("%s|%s" % (sys.argv[1], sys.argv[2])).encode()
print(1430 + int(hashlib.sha256(seed).hexdigest(), 16) % 450)
PY
}

# Nothing listening, on either loopback family.
#
# Both, because it is not obvious which one vite will pick: `localhost` resolves
# to ::1 first on this machine, which is why `curl 127.0.0.1:1420` refuses
# while the owner's server is up and answering perfectly well.
port_is_free() {
  python3 - "$1" <<'PY'
import socket, sys
port = int(sys.argv[1])
for family, address in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
    probe = socket.socket(family, socket.SOCK_STREAM)
    # SO_REUSEADDR because node sets it too, and without it a port left in
    # TIME_WAIT by this instance's own last `qa down` reads as taken — so every
    # restart walked one port further along. It does not let this bind past a
    # live listener; that is SO_REUSEPORT, which is deliberately not set.
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind((address, port))
    except OSError:
        raise SystemExit(1)
    finally:
        probe.close()
raise SystemExit(0)
PY
}

vite_answers() { curl -sf -o /dev/null "http://localhost:$1/"; }

# The port of a dev server this instance already owns, if it is still alive.
running_vite_port() {
  [ -f "$VITE_STATE" ] || return 1
  local port pid
  read -r port pid <<<"$(python3 - "$VITE_STATE" <<'PY'
import json, sys
try:
    state = json.load(open(sys.argv[1]))
    print(int(state["port"]), int(state["pid"]))
except Exception:
    raise SystemExit(1)
PY
)" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  vite_answers "$port" || return 1
  echo "$port"
}

# Bring up a dev server this instance owns outright, and set VITE_PORT.
#
# The old version of this asked whether *anything* was listening on 1420 and
# started `bun run dev` from the calling directory if not. Two failures came out
# of that in one day: an agent's worktree bound 1420 and the owner's window
# rendered in-progress code while he read real mail, and agents that pointed
# their instance elsewhere silently kept loading somebody else's frontend.
#
# `--strictPort` is the property that makes this safe. Vite gets the port it was
# given or exits; there is no fallback to "some other port" and no way to end up
# attached to a server this script did not start.
ensure_vite() {
  if [ "$INSTANCE" = "main" ]; then
    # The owner's app and the owner's port. An agent reaching this line means
    # MACH_QA_INSTANCE was forgotten — refuse before anything binds.
    ! is_worktree || die "refusing to serve 1420 from a worktree.
  1420 is where the owner's running app loads its frontend from, and a worktree
  is not his checkout. An agent's frontend has been served into his live window
  this way, twice. Launch one of your own instead:
      MACH_QA_INSTANCE=agent scripts/qa up"
    vite_answers 1420 && { VITE_PORT=1420; return 0; }
    ( cd "$REPO" && nohup bun run dev >"$VITE_LOG" 2>&1 & )
    for _ in $(seq 1 30); do vite_answers 1420 && { VITE_PORT=1420; return 0; }; sleep 1; done
    die "vite did not come up; see $VITE_LOG"
  fi

  if VITE_PORT="$(running_vite_port)"; then
    return 0
  fi

  local base attempt port vpid waited
  base="$(derived_port_base)"
  for attempt in $(seq 0 49); do
    port=$((base + attempt))
    # The non-negotiable one. The arithmetic cannot reach 1420 or vite's HMR
    # port, and this says so out loud anyway: a range that drifts is a change
    # somebody makes without thinking about this line.
    if [ "$port" -le 1421 ]; then
      die "derived port $port collides with the owner's — this is a bug in derived_port_base"
    fi
    port_is_free "$port" || continue

    ( cd "$REPO" && exec nohup "$REPO/node_modules/.bin/vite" \
        --port "$port" --strictPort >"$VITE_LOG" 2>&1 ) &
    vpid=$!

    waited=0
    while [ "$waited" -lt 20 ]; do
      if vite_answers "$port"; then
        python3 - "$VITE_STATE" "$port" "$vpid" "$REPO" "$INSTANCE" <<'PY'
import json, sys
path, port, pid, repo, instance = sys.argv[1:6]
json.dump({"port": int(port), "pid": int(pid), "repo": repo, "instance": instance},
          open(path, "w"))
PY
        VITE_PORT="$port"
        echo "qa[$INSTANCE]: vite on $port (pid $vpid)  $VITE_LOG"
        return 0
      fi
      # Lost the race to another agent scanning the same range, or the port was
      # taken between the probe and the bind. strictPort turns that into an
      # exit, which is exactly what makes it detectable.
      kill -0 "$vpid" 2>/dev/null || break
      sleep 1
      waited=$((waited + 1))
    done
    kill "$vpid" 2>/dev/null || true
  done

  die "no free dev-server port in $base–$((base + 49)); see $VITE_LOG"
}

# The URL this instance's binary must load, once `ensure_vite` has decided.
dev_url() { echo "http://localhost:$VITE_PORT"; }

instance_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid="$(cat "$PIDFILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# Window rect for THIS instance's pid. Returns "x y w h".
window_rect() {
  local pid; pid="$(instance_pid)" || return 1
  osascript <<APPLESCRIPT 2>/dev/null
tell application "System Events"
  set procs to (every process whose unix id is $pid)
  if procs is {} then return ""
  tell item 1 of procs
    if (count of windows) is 0 then return ""
    set p to position of window 1
    set s to size of window 1
    return ((item 1 of p) as string) & " " & ((item 2 of p) as string) & " " & ((item 1 of s) as string) & " " & ((item 2 of s) as string)
  end tell
end tell
APPLESCRIPT
}

# The window's CGWindowID, for capturing its own buffer without raising it.
window_id() {
  local pid; pid="$(instance_pid)" || return 1
  "$REPO/scripts/windowid.py" "$pid" 2>/dev/null
}

focus() {
  local pid; pid="$(instance_pid)" || return 0
  osascript -e "tell application \"System Events\" to set frontmost of (item 1 of (every process whose unix id is $pid)) to true" >/dev/null 2>&1 || true
}

# Refuse to type into somebody else's window.
#
# `focus` asks System Events to raise the instance. A QA instance cannot be
# raised: `shell.rs` puts every non-`main` instance under an Accessory
# activation policy precisely so it can never take the keyboard. So the raise
# silently fails, `cliclick` types into whatever *is* frontmost — and on this
# machine that is the owner's own Mach, reading his real mail.
#
# That happened. An agent sent "read this thread and reply, Claude" into the
# live mailbox as mail-list keystrokes, and the `e` archived a conversation.
#
# So the OS-input path now proves the target is frontmost before it types, and
# dies if it is not. There is no flag to skip this.
require_frontmost() {
  # The owner's instance is never a target. Being frontmost is not the safety
  # property — his window is frontmost most of the time, which is exactly when
  # typing into it does the most damage. This was written after the guard below
  # was added and then immediately defeated by testing it against `main` while
  # his window happened to be in front.
  [ "$INSTANCE" = "main" ] && die "MACH_QA_INPUT will not type into the owner's instance. \
Launch one of your own: MACH_QA_INSTANCE=agent scripts/qa up"

  local pid; pid="$(instance_pid)" || die "not running"
  local front
  front="$(osascript -e 'tell application "System Events" to get unix id of first process whose frontmost is true' 2>/dev/null || echo "")"
  [ "$front" = "$pid" ] && return 0
  local name
  name="$(ps -p "${front:-0}" -o comm= 2>/dev/null | xargs basename 2>/dev/null || echo "something else")"
  die "MACH_QA_INPUT would type into $name (pid ${front:-unknown}), not instance '$INSTANCE' (pid $pid).
  A QA instance runs under an Accessory policy and cannot be raised, so synthetic
  input goes to whatever is frontmost — which is how an agent once typed into the
  owner's real mailbox. Use the in-page verbs instead: qa key / qa click / qa ui."
}

cmd_seed() {
  [ "$INSTANCE" != "main" ] || die "seed is for agent instances; MACH_QA_INSTANCE=main is the real store"
  [ -f "$REAL_DB" ] || die "no store to copy from at $REAL_DB"
  mkdir -p "$DATA_DIR"
  if [ -f "$DB" ] && [ "${1:-}" != "--force" ]; then
    die "$DB already exists (pass --force to replace it)"
  fi
  # A live WAL means a plain cp can copy a torn database. sqlite3 .backup
  # takes a consistent snapshot while the owner's app keeps writing.
  sqlite3 "$REAL_DB" ".backup '$DB'"
  echo "seeded $DB from the real store"
  sqlite3 "$DB" "SELECT (SELECT count(*) FROM threads)||' threads, '||(SELECT count(*) FROM messages)||' messages, '||(SELECT count(*) FROM events)||' events';"
  echo
  echo "NOTE: credentials do not come with it. Tokens live in the Keychain, and"
  echo "      this instance addresses its own service ($KEYCHAIN_SERVICE),"
  echo "      which is empty. Every account above will report \"needs"
  echo "      reauthorization\" and no sync pass will reach Google. That is the"
  echo "      intended state: mail and calendars to look at, no credentials."
}

# ---------------------------------------------------------------------------
# Which binary is this instance actually running?
# ---------------------------------------------------------------------------
#
# Every worktree shares the parent's target directory (see `bin/worktree-setup`
# — a private one costs several minutes and about 2GB per agent). The price is
# that `cargo build` in any worktree replaces `debug/mach` for everybody, and an
# agent halfway through a QA run is suddenly testing somebody else's Rust. One
# agent caught it by grepping the running binary for a symbol it did not
# recognise; the rest would not have noticed at all.
#
# So every instance is launched from its own copy, taken at `up`, under
# .qa/<instance>/bin/mach. Whatever anyone builds afterwards, the process you
# are screenshotting is running the bytes you tested.
#
# `main` was the exception until it wasn't. It ran `debug/mach` in place, and
# the owner spent a day in an agent's unmerged build without noticing — the app
# looked completely normal. Two things had to move with it:
#
#   - `staleness.rs` asked "has a newer build landed since I started?" by
#     stat-ing `current_exe()`, which is now a copy whose mtime never moves. It
#     reads MACH_BUILD_WATCH instead, exported below and pointing at the shared
#     artifact — the thing that actually changes. The banner keeps working.
#   - `main` used to sign `debug/mach` itself, being "the one case where it *is*
#     the thing about to run". It no longer is, so the copy is what gets signed.
#     That costs no Keychain prompt: the designated requirement a Developer ID
#     signature carries names the identifier and the team and says nothing about
#     a path, and the partition-list entry is `teamid:` for the same reason. Same
#     identifier, same certificate, same identity — a different path is invisible
#     to both gates. `scripts/sign` explains why that is the only thing that ever
#     mattered.
#
# A copy rather than a hard link, and the seventy megabytes are the price of the
# second property: the copy is signed on its own (`scripts/sign --only`), so an
# agent's QA run never rewrites the artifact somebody else's app was launched
# from. A hard link is the same inode, so signing one signs the other.
#
# It is not a complete answer: it protects the run in progress and says nothing
# about *whose* code you built in the first place. That is what `built_here`
# below is for — the copy is only ever taken from an artifact carrying this
# checkout's path, and `up` rebuilds rather than pin somebody else's. `cargo
# build` still serialises on the target lock, and two agents editing the same
# crate still overwrite each other's artifact between runs. The honest advice is
# to build and `up` in one breath, and to read the drift line in `qa state`.
pin_binary() {
  built_here || rebuild_ours
  mkdir -p "$(dirname "$LAUNCH_BIN")"
  rm -f "$LAUNCH_BIN"
  cp "$BIN" "$LAUNCH_BIN" || die "could not take a copy of $BIN"
  binary_stamp "$BIN" >"$QA_DIR/bin/from.json"
}

# Was `debug/mach` compiled from *this* checkout?
#
# `qa::dev::BUILT_FROM` is `env!("CARGO_MANIFEST_DIR")`, baked in at compile
# time and printed at startup precisely so this question has a cheap answer. A
# debug build with `split-debuginfo=unpacked` carries no paths otherwise, which
# is why "is this my binary" used to be unanswerable without reading the log of
# a process you had already started.
built_here() {
  [ -x "$BIN" ] || return 1
  LC_ALL=C grep -a -q -F "$REPO/src-tauri" "$BIN"
}

# Somebody else uplifted their artifact over `debug/mach` between our build and
# our copy. Their build did not delete ours — it is still in `target/debug/deps`
# under this checkout's own hash — so one `cargo build` puts it back, and this
# is a second or two rather than a full compile.
rebuild_ours() {
  echo "qa[$INSTANCE]: $BIN was built somewhere else; rebuilding from this checkout" >&2
  ( cd "$REPO/src-tauri" && cargo build >/dev/null 2>&1 ) || true
  built_here && return 0
  die "$BIN is not this checkout's build, and rebuilding did not reclaim it.
  Every worktree shares the parent's target directory and they all uplift to the
  same debug/mach, so the last build wins the name. Run:
      cd src-tauri && cargo build
  and try again — and if it keeps losing, another agent is building in a loop."
}

# inode, size and mtime — enough to tell "the same artifact" from "a rebuild".
binary_stamp() {
  python3 - "$1" <<'PY'
import json, os, sys
try:
    info = os.stat(sys.argv[1])
except OSError:
    print("{}")
    raise SystemExit(0)
json.dump({"path": sys.argv[1], "inode": info.st_ino, "size": info.st_size,
           "mtime": int(info.st_mtime)}, sys.stdout)
PY
}

# The checkout the process in the window was compiled from, as it said itself.
#
# Read off the log rather than out of the binary: `> "$LOG"` truncates at every
# `up`, so the first line belongs to the run that is on screen. Grepping
# `$LAUNCH_BIN` would answer a question about a *file*, and the file is not
# necessarily what the live process is executing — `qa up` unlinks the old copy
# and the running process keeps its inode.
running_built_from() {
  [ -f "$LOG" ] || return 1
  local from
  from="$(LC_ALL=C sed -n 's/^mach: built from //p' "$LOG" | head -n1)"
  [ -n "$from" ] || return 1
  printf '%s\n' "$from"
}

# "" when the instance is still on what it was launched from, a sentence when
# the shared artifact has moved on underneath it.
binary_drift() {
  [ -f "$QA_DIR/bin/from.json" ] || return 0
  python3 - "$QA_DIR/bin/from.json" "$BIN" <<'PY'
import json, os, sys, time
try:
    was = json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(0)
try:
    now = os.stat(sys.argv[2])
except OSError:
    print("the shared binary is gone (%s)" % sys.argv[2])
    raise SystemExit(0)
if now.st_ino != was.get("inode"):
    print("another build replaced %s at %s — this instance is still running the "
          "one you launched (%s). `qa restart` would take theirs."
          % (sys.argv[2], time.strftime("%H:%M:%S", time.localtime(now.st_mtime)),
             was.get("path")))
PY
}

cmd_up() {
  if pid="$(instance_pid)"; then echo "already running (pid $pid)"; return 0; fi
  [ -x "$BIN" ] || die "no binary at $BIN — run: cd src-tauri && cargo build"
  [ -f "$REPO/.env.local" ] || die "no .env.local — the app would boot 'not configured'"
  [ "$INSTANCE" = "main" ] || [ -f "$DB" ] || echo "qa[$INSTANCE]: no seeded store; starting empty (try: qa seed)"

  ensure_vite
  pin_binary

  # The `Mach.app` that makes a banner say "Mach" instead of "Terminal". It is
  # an Info.plist and an icon for LaunchServices to read; nothing runs from it,
  # and the binary launched below is unchanged. Idempotent and a fifth of a
  # second once it exists. See `scripts/dev-bundle`.
  "$REPO/scripts/dev-bundle" || true

  # Same signature every build, so the Keychain stops treating each rebuild as
  # a new program and re-asking for the login password. A no-op until the
  # identity exists; see `scripts/sign --setup`.
  #
  # The copy is what launches, so the copy is what has to carry the signature.
  # Same identifier and same identity as the artifact would have got, which is
  # what keeps the Keychain quiet: a Developer ID designated requirement names
  # the identifier and the team, not a path.
  #
  # Nobody signs the shared `debug/mach` any more. It may be the file a running
  # app — possibly the owner's — was launched from, and `codesign --force`
  # rewrites it.
  "$REPO/scripts/sign" --only "$LAUNCH_BIN" com.mach.mail >/dev/null 2>&1 || true

  # The helper binaries read the Keychain on their own account and are run from
  # the target directory directly, so they still need a stable identity. Only
  # the owner's instance does this: they are shared, like everything else in
  # there, and an agent has no business re-signing them mid-run.
  if [ "$INSTANCE" = "main" ]; then
    "$REPO/scripts/sign" --only "$TARGET_DIR/debug/calendar_live" com.mach.mail.calendar-live >/dev/null 2>&1 || true
    "$REPO/scripts/sign" --only "$TARGET_DIR/debug/plugin_probe" com.mach.mail.plugin-probe >/dev/null 2>&1 || true
  fi

  # `exec` matters: without it the subshell stays alive as the parent and $!
  # is the *wrapper's* pid, not the app's — so every window lookup misses and
  # `shoot` silently degrades to a whole-screen capture. exec replaces the
  # subshell with the binary, so the recorded pid is the GUI process.
  (
    cd "$REPO" || exit 1
    set -a; . ./.env.local; set +a
    [ -n "$DATA_DIR" ] && export MACH_DATA_DIR="$DATA_DIR"
    # Read at runtime by `qa::dev::apply`. The compiled-in devUrl is 1420 for
    # everybody, so without this a QA instance would load the owner's server —
    # and the app refuses to start rather than do that silently.
    #
    # A caller may set it, and one reason to is `?fixtures`: the real window
    # rendering invented mail, which is the only way to photograph the app for
    # publication without photographing somebody's real inbox. The port is still
    # checked below, so a hand-written value cannot aim at 1420 either.
    export MACH_DEV_URL="${MACH_DEV_URL:-$(dev_url)}"
    # What "a newer build is waiting" is measured against. `staleness.rs` used
    # to stat `current_exe()`, which was `debug/mach` back when instances ran it
    # in place; the pinned copy above never changes, so watching it would report
    # "current" forever and quietly retire the banner. The artifact is what
    # moves, so the artifact is what gets watched.
    export MACH_BUILD_WATCH="$BIN"
    exec "$LAUNCH_BIN" >"$LOG" 2>&1
  ) &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 30); do instance_pid >/dev/null && break; sleep 1; done
  pid="$(instance_pid)" || die "the app did not start; see $LOG"

  # Wait for a window, not just a process.
  #
  # A debug build opening a large store takes appreciably longer to put a
  # window on screen than it takes to fork, and `up` used to return in between.
  # Anything that then tried to `shoot` got "no capturable window", which reads
  # as "the app is broken" rather than "ask again in a moment" — an agent
  # reported exactly that and concluded its own change had broken the build.
  local waited=0
  while [ "$waited" -lt 60 ]; do
    if [ -n "$(window_id)" ]; then
      echo "up (pid $pid)  frontend=$(dev_url)${DATA_DIR:+  data=$DATA_DIR}"
      return 0
    fi
    kill -0 "$pid" 2>/dev/null || die "the app exited during startup; see $LOG"
    sleep 1
    waited=$((waited + 1))
  done

  echo "up (pid $pid)${DATA_DIR:+  data=$DATA_DIR}"
  echo "qa[$INSTANCE]: running, but no window after ${waited}s — see $LOG" >&2
  keychain_notice
}

# Is a Keychain authorization dialog what is actually blocking?
#
# It is worth checking by name, because the symptom is otherwise inscrutable: a
# live process, no window, nothing in the log. A rebuilt binary has a new code
# signature, so the login keychain stops recognising it and macOS puts up a
# password prompt — which is a modal panel above the ordinary window layer,
# hence `--any-layer`. Nobody can guess that from "no window after 60s".
keychain_notice() {
  local agent
  for agent in $(pgrep -x SecurityAgent 2>/dev/null); do
    if "$REPO/scripts/windowid.py" "$agent" --any-layer >/dev/null 2>&1; then
      echo "qa[$INSTANCE]: a Keychain dialog is waiting on screen — approve it" >&2
      echo "               (\"Always Allow\" stops it asking for this build)" >&2
      return 0
    fi
  done
  return 1
}

cmd_down() {
  # The app removes its own token file when it shuts down cleanly, and a
  # SIGTERM is not a clean shutdown. A bearer token for a port that no longer
  # exists is only untidy rather than dangerous, and it should still not be
  # left lying in the tree.
  [ -n "$CONTROL" ] && rm -f "$CONTROL"
  if pid="$(instance_pid)"; then kill "$pid" 2>/dev/null || true; rm -f "$PIDFILE"; echo "stopped (pid $pid)";
  else echo "not running"; fi

  # Its own dev server goes with it. Nobody else is on that port — the whole
  # point of deriving one per instance — and the alternative is what the machine
  # looked like before: a vite left over from every worktree an agent ever
  # touched, all of them still watching files.
  #
  # Never for `main`: 1420 is the owner's, and his window is loading from it.
  if [ "$INSTANCE" != "main" ] && [ -f "$VITE_STATE" ]; then
    local vpid
    vpid="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["pid"])' "$VITE_STATE" 2>/dev/null || echo "")"
    [ -n "$vpid" ] && kill "$vpid" 2>/dev/null && echo "stopped vite (pid $vpid)"
    rm -f "$VITE_STATE"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# KNOWN: `shoot` does not capture context menus. Your menu is not broken.
# ---------------------------------------------------------------------------
#
# Open either context menu — mail or calendar, ⇧F10 or `qa menu` — and:
#
#   qa menu '[data-thread-id="46599"]'   → matched: true
#   qa ui                                → overlays: 1
#   qa click '[data-slot="context-menu-item"]'  → matched: true, and it runs
#   qa shoot after                       → no menu anywhere in the image
#
# The menu is real. It is mounted, positioned, hit-testable, and choosing an
# item does what the item says. It is only the *screenshot* that does not have
# it, and an agent who believed the screenshot would conclude the menu never
# opened and go and "fix" working code.
#
# Five explanations have been tested and are not it. Do not spend the hour
# again:
#
#   1. Not a second window or a higher window layer. `CGWindowListCopyWindowInfo`
#      reports exactly one window for the pid, layer 0, 1440x900 — the one
#      `shoot` captures. Base UI portals to `document.body` and does not use
#      the popover API, so there is no top layer involved either.
#   2. Not the entry animation. `POPUP_SURFACE` fades and scales in over 100ms
#      and dialogs do not, which looks like the answer. Stripping the transition
#      out of `popup.ts` and re-shooting changes nothing.
#   3. Not occlusion, and not a stale buffer. A QA window is normally covered by
#      other windows, but Preferences — opened with `qa key 'mod+,'` in exactly
#      that state — captures perfectly, and so does a list that has just
#      re-rendered around a new search.
#   4. Not `position: absolute` vs the offset parent. `positionMethod="fixed"`
#      on the positioner makes no difference.
#   5. Not the app. Point headless Chrome at the same dev server — `MACH_WEB_URL`
#      — dispatch `contextmenu` on a row, and the popup is at its anchor with
#      `opacity: 1`, `visibility: visible`, and focus inside it.
#
# The one difference that survives all of that: in the QA window the popup never
# takes DOM focus. `qa ui` reports `focused: null` with the menu open, where
# Blink reports the popup itself. Whether that is the cause or another symptom
# is not settled.
#
# So, until somebody settles it, assert on menus instead of photographing them:
#
#   qa ui                                       # overlays goes 0 → 1
#   qa click '[data-slot="context-menu-item"]'  # and the item does its work
#
# and use `bun scripts/webqa.ts` against this instance's own dev server when you
# need to *look* at a popup. It is Blink rather than WebKit, and for a menu's
# layout that is a real limitation — but it beats a blank rectangle.
cmd_shoot() {
  local name="${1:-shot}"
  local pid; pid="$(instance_pid)" || die "not running — try: qa up"
  local out="$QA_DIR/$name.png"

  # Captured by window id, which reads the window's own buffer: occluded,
  # behind other apps, on another Space — it does not matter, and nothing is
  # raised or focused. Raising the window to photograph it steals focus from
  # whoever is using the machine, and an agent iterating visually would do that
  # every few seconds.
  # Retry rather than fail on the first miss: a window that is merely still
  # being built is the common case, and a hard failure here is indistinguishable
  # from a genuinely broken app.
  local wid=""
  local tries=0
  while [ "$tries" -lt 20 ]; do
    wid="$(window_id)" || wid=""
    [ -n "$wid" ] && break
    sleep 1
    tries=$((tries + 1))
  done

  if [ -n "$wid" ]; then
    screencapture -x -o -l"$wid" "$out"
    echo "$out  (window $wid, pid $pid — not raised)"
    return 0
  fi

  # No window. Almost always the display is asleep or the app has not finished
  # launching. A black frame read as "the UI is broken" is worse than no frame.
  if pmset -g powerstate IODisplayWrangler 2>/dev/null | tail -1 | grep -qE '^ *[0-3] '; then
    die "the display is asleep or locked — wake it and retry"
  fi
  die "no capturable window for pid $pid (still launching?)"
}

cmd_state() {
  local pid; pid="$(instance_pid)" || pid=""
  echo "instance: $INSTANCE"

  # A process this script did not start is a process it cannot stop, and one
  # you can be looking at while `qa down && qa up` restarts a different one.
  # That is how two and a half hours of Rust changes stayed off screen: the
  # pidfile named one process and the window belonged to another.
  local strays=""
  for other in $(pgrep -x mach 2>/dev/null); do
    [ "$other" = "$pid" ] || strays="$strays $other"
  done
  if [ -n "$strays" ]; then
    echo "WARNING : untracked mach process(es)$strays — qa cannot stop these," >&2
    echo "          and one of them may be the window you are looking at." >&2
    for other in $strays; do
      echo "          pid $other started $(ps -p "$other" -o lstart= 2>/dev/null | xargs)" >&2
    done
  fi
  # Spelled out: `${pid:+running (pid $pid)}${pid:-NOT RUNNING}` prints the pid
  # again in the running case — the second expansion substitutes when the
  # variable is *set*, not when the first one was empty. It read
  # "running (pid 25769)25769".
  if [ -n "$pid" ]; then echo "process : running (pid $pid)"; else echo "process : NOT RUNNING"; fi

  # The port this instance's frontend comes from, and whether it is answering.
  # Printed rather than assumed: "which vite am I looking at" was unanswerable
  # when there was only ever one, and it is the first question now that there
  # is one per instance.
  local port
  if [ "$INSTANCE" = "main" ]; then port=1420; else port="$(running_vite_port || echo "")"; fi
  if [ -n "$port" ]; then
    echo "vite    : http://localhost:$port  $(vite_answers "$port" && echo up || echo DOWN)"
  else
    echo "vite    : none yet (qa up starts one; never 1420 for a QA instance)"
  fi

  echo "binary  : $LAUNCH_BIN"

  # Which checkout compiled the code in that window.
  #
  # This is the line that would have saved a day. The owner used his mail client
  # for one, on a binary an agent had built in a worktree from code that was
  # never merged; he found it by chance, in the log. So it is reported here,
  # from the process's own first line rather than from anything about a file —
  # `qa::dev::apply` prints `mach: built from <CARGO_MANIFEST_DIR>` at startup
  # precisely so the question has a cheap, honest answer.
  local built; built="$(running_built_from || true)"
  if [ -z "$built" ]; then
    echo "built   : <no 'built from' line in $LOG>"
  else
    echo "built   : $built"
    if [ "$built" != "$REPO/src-tauri" ]; then
      echo "WARNING : that is not this checkout ($REPO/src-tauri). The window you are" >&2
      echo "          looking at is running somebody else's Rust — every worktree" >&2
      echo "          shares one target dir and the last build wins the name." >&2
      echo "          \`qa restart\` rebuilds from here and relaunches onto it." >&2
    fi
  fi

  local drift; drift="$(binary_drift)"
  [ -n "$drift" ] && echo "WARNING : $drift" >&2

  echo "store   : $DB"
  echo "keychain: $KEYCHAIN_SERVICE"
  local rect; rect="$(window_rect 2>/dev/null)" || rect=""
  echo "window  : ${rect:-<none>}"
  [ -f "$DB" ] || { echo "db      : <none yet>"; return 0; }
  sqlite3 "$DB" <<'SQL'
.mode list
.headers off
SELECT 'accounts: ' || COALESCE(group_concat(email || ' [' || COALESCE(history_id,'backfilling') || ']', ', '), '<none>') FROM accounts;
SELECT 'threads : ' || count(*) FROM threads;
SELECT 'messages: ' || count(*) FROM messages;
SELECT 'labels  : ' || count(*) FROM labels;
SELECT 'events  : ' || count(*) || '  (' || COALESCE(min(date(start_ts/1000,'unixepoch')),'-') || ' .. ' || COALESCE(max(date(start_ts/1000,'unixepoch')),'-') || ')' FROM events;
SQL
}

# ---------------------------------------------------------------------------
# The control port
# ---------------------------------------------------------------------------
#
# One POST per verb, to a loopback port bound to 127.0.0.1 on an ephemeral
# port, carrying the bearer token the app wrote alongside it. Three verbs and
# no more; there is deliberately no way to ask the window to run code. See
# `src-tauri/src/qa/` for what a reader of that port could do and what stops
# them.
#
# python3 rather than curl and jq: it is what `windowid.py` already needs, and
# it reads the endpoint file, sends the request and pretty-prints the answer
# without a second tool having to be installed.
control() {
  local verb="$1" argument="${2:-}"
  [ -n "$CONTROL" ] || die "the control port only exists on a QA instance — try MACH_QA_INSTANCE=agent"
  instance_pid >/dev/null || die "not running — try: qa up"
  [ -f "$CONTROL" ] || die "no control port at $CONTROL (still starting? release build? see $LOG)"
  MACH_QA_VERB="$verb" MACH_QA_ARG="$argument" python3 - "$CONTROL" <<'PY'
import json, os, sys, urllib.error, urllib.request

endpoint = json.load(open(sys.argv[1]))
body = json.dumps({
    "verb": os.environ["MACH_QA_VERB"],
    "argument": os.environ["MACH_QA_ARG"],
}).encode()
request = urllib.request.Request(
    "http://127.0.0.1:%d/qa" % endpoint["port"],
    data=body,
    headers={
        "Authorization": "Bearer " + endpoint["token"],
        "Content-Type": "application/json",
    },
)
try:
    with urllib.request.urlopen(request, timeout=20) as response:
        answer = json.load(response)
except urllib.error.HTTPError as e:
    answer = {"ok": False, "error": "%d %s" % (e.code, e.read().decode("utf-8", "replace").strip())}
except OSError as e:
    answer = {"ok": False, "error": str(e)}

print(json.dumps(answer, indent=2, sort_keys=True))
sys.exit(0 if answer.get("ok") else 1)
PY
}

# A keymap token, delivered in-page. No OS input, no focus change.
#
# MACH_QA_INPUT=1 is the old path: real synthetic input, which raises the
# window and takes the keyboard from whoever is at the machine. It speaks
# cliclick rather than keymap tokens.
cmd_key() {
  [ $# -gt 0 ] || die "usage: qa key <binding>   e.g. 'mod+2', 'g i', c, '?'"
  if [ "${MACH_QA_INPUT:-}" = "1" ]; then
    command -v cliclick >/dev/null || die "cliclick is not installed (brew install cliclick)"
    instance_pid >/dev/null || die "not running"
    focus; sleep 0.6
    require_frontmost
    cliclick "$@"
    return
  fi
  control key "$1"
}

cmd_click() {
  [ $# -eq 1 ] || die "usage: qa click <css selector>   e.g. '[data-thread-id=\"41774\"]'"
  if [ "${MACH_QA_INPUT:-}" = "1" ]; then
    command -v cliclick >/dev/null || die "cliclick is not installed"
    local rect; rect="$(window_rect)" || die "cannot read the window rect"
    # shellcheck disable=SC2086
    set -- $rect "$1"
    local wx="$1" wy="$2" xy="$5"
    local rx="${xy%%,*}" ry="${xy##*,}"
    focus; sleep 0.5
    require_frontmost
    cliclick "c:$((wx + rx)),$((wy + ry))"
    echo "clicked window($rx,$ry)"
    return
  fi
  control click "$1"
}

# The right-click. `click` cannot do this: its sequence has no `contextmenu`,
# and both of the app's context menus — mail and calendar — hang off exactly
# that event, so neither was reachable from this port at all.
cmd_menu() {
  [ $# -eq 1 ] || die "usage: qa menu <css selector>   e.g. '[data-thread-id=\"41774\"]'"
  control rightclick "$1"
}

# Text, into whatever has the caret.
#
# Not `key`. `key` asks the keymap what a binding means, which is the right
# question for `e` and the wrong one for the letter e: a `KeyboardEvent` the
# page constructs carries no default action, so dispatching one at a composer
# edits nothing at all. See `src/lib/qa-bridge.ts` for what does the editing.
cmd_type() {
  [ $# -gt 0 ] || die "usage: qa type <text>"
  control type "$*"
}

# One editing key, with the edit performed: Enter, Backspace, Delete, Tab,
# Escape, the arrows, Home/End, and mod+Backspace for delete-to-line-start.
cmd_press() {
  [ $# -eq 1 ] || die "usage: qa press <key>   e.g. Enter, Backspace, mod+Backspace"
  control press "$1"
}

cmd_ui() { control ui; }

# Open the in-app page window on a LOCAL fixture.
#
# `src-tauri/src/browser.rs` is the one webview in Mach that runs script
# somebody else wrote, and looking at it is the only way to check what it shows
# and what it refuses. It must never be pointed at a real unsubscribe URL out of
# the owner's mail: loading one is a tracking beacon that confirms his address
# is read, which is the whole thing the unsubscribe rule exists to avoid.
#
# So the verb takes loopback and nothing else — the app refuses anything that is
# not http(s) on 127.0.0.1, localhost or ::1 — and there is a fixture beside it:
#
#   python3 -m http.server 8975 -d scripts/fixtures/page &
#   MACH_QA_INSTANCE=agent scripts/qa browser http://127.0.0.1:8975/hostile.html
#   MACH_QA_INSTANCE=agent scripts/qa shoot page
cmd_browser() {
  [ $# -eq 1 ] || die "usage: qa browser <http://127.0.0.1:PORT/page.html>"
  control browser "$1"
}

cmd_logs() { tail -n "${1:-30}" "$LOG"; }

# Rebuild, then restart onto what was just built.
#
# The rebuild is the point. The frontend hot-reloads through Vite, so after a
# `git pull` the window looks current while the Rust half is whatever was
# running before — a mismatched pair that fails in ways that look like ordinary
# bugs. It has cost this project a whole afternoon twice: once chasing a
# calendar save path that was already fixed, once with preferences silently
# having nowhere to persist to because the migration was not in the process.
#
# `cargo build` is incremental, so this is a second or two when nothing changed.
cmd_restart() {
  echo "building…"
  ( cd "$REPO/src-tauri" && cargo build 2>&1 | grep -E '^(error|warning)' ) && {
    echo "qa[$INSTANCE]: build reported problems — not restarting" >&2
    return 1
  }
  cmd_down
  cmd_up
}

case "${1:-}" in
  up)      shift; cmd_up "$@" ;;
  down)    shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  seed)  shift; cmd_seed "$@" ;;
  shoot) shift; cmd_shoot "$@" ;;
  state) shift; cmd_state "$@" ;;
  key)   shift; cmd_key "$@" ;;
  click) shift; cmd_click "$@" ;;
  menu)  shift; cmd_menu "$@" ;;
  type)  shift; cmd_type "$@" ;;
  press) shift; cmd_press "$@" ;;
  ui)    shift; cmd_ui "$@" ;;
  browser) shift; cmd_browser "$@" ;;
  logs)  shift; cmd_logs "$@" ;;
  # Between markers rather than by line number: the help was `sed -n '4,58p'`,
  # which silently started printing the wrong paragraph the first time anything
  # above it grew.
  *) awk '/^# USAGE-BEGIN/{on=1;next} /^# USAGE-END/{exit} on{sub(/^# ?/,"");print}' \
       "${BASH_SOURCE[0]}"; exit 1 ;;
esac
