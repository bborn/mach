#!/usr/bin/env bash
set -euo pipefail
#
# scripts/qa — look at a running Mach instead of guessing.
#
#   qa up            launch YOUR instance (the real mailbox)
#   qa down          stop it
#   qa restart       rebuild and relaunch — what you want after a `git pull`
#   qa shoot NAME    screenshot the window -> .qa/<instance>/NAME.png
#   qa state         process, window, accounts, sync watermark, row counts
#   qa logs [n]      tail the log
#   qa key BINDING   press a key in the window: 'mod+2', 'g i', 'c', '?'
#   qa click CSS     click the first match: '[data-thread-id="41774"]'
#   qa ui            what is on screen: mode, cursor, selection, overlay, rows
#
# ---------------------------------------------------------------------------
# DRIVE THE REAL APP. NEVER TOUCH THE OWNER'S FOCUS.
# ---------------------------------------------------------------------------
#
# Someone is using this machine, and the whole design here follows from that.
#
#   `qa up` on an instance OTHER than `main` is safe. Those processes set an
#   Accessory activation policy and build their window unfocused (see
#   `src-tauri/src/shell.rs`), so they never appear in the Dock, never become
#   the active application, and cannot take a keystroke — while still being a
#   real window. `qa up` on `main` is the owner's own app and is off limits.
#
#   `qa shoot` is safe. It captures the window's own buffer by CGWindowID, so
#   the window is never raised — occluded, backgrounded, whatever.
#
#   `qa key`, `qa click` and `qa ui` are safe on a QA instance. They do not
#   send OS input. They POST one of three verbs to a loopback port the app
#   opens for QA instances in development builds; the frontend synthesises the
#   keystroke and hands it to the keymap, or dispatches the click in the page.
#   Focus never moves, because nothing about this involves the window server.
#   See `src-tauri/src/qa/` and `src/lib/qa-bridge.ts`.
#
#   MACH_QA_INPUT=1 switches `key` and `click` back to real OS input, which
#   raises the window and takes the keyboard. It takes a cliclick spec
#   (`kp:return`, `t:hello`) and window-relative `X,Y` instead of a binding and
#   a selector. It exists for the rare thing the page cannot see — a native
#   menu, a system dialog — and you should have a reason.
#
# So: the real app is the answer for anything native. A window edge, the
# traffic lights, a WebKit-only behaviour, a composer, a full-screen surface —
# launch a QA instance and drive it.
#
#   MACH_QA_INSTANCE=agent scripts/qa up
#   MACH_QA_INSTANCE=agent scripts/qa key 'mod+,'
#   MACH_QA_INSTANCE=agent scripts/qa shoot prefs
#   MACH_QA_INSTANCE=agent scripts/qa ui
#
# Headless Chrome against Vite is still there and is still right for pure
# component and logic work, where a second engine costs nothing. `webqa.ts`
# clicks, types, reads the DOM and screenshots with no window at all:
#
#   bun scripts/webqa.ts reload    # …and reports what the page load logged
#   bun scripts/webqa.ts eval '<javascript>'
#
# Use `reload` first when a page looks blank: it holds one CDP session across
# the navigation and prints the exceptions, which is the only way to see an
# error thrown before the app finished mounting. What it cannot tell you is
# anything about the app as a Mac application: it is Blink, in a tab, with no
# traffic lights, no overlay title bar and a different scrollbar engine. Four
# defects shipped verified that way.
#
# Real-data checks do not need the UI at all: `qa state` reads the database.
#
# ---------------------------------------------------------------------------
# INSTANCES
# ---------------------------------------------------------------------------
#
# `MACH_QA_INSTANCE=agent qa up` launches a SEPARATE app with its own SQLite
# store under .qa/agent/data, its own window, and its own log. Nothing it does
# touches the mailbox the owner is reading.
#
#   MACH_QA_INSTANCE=agent scripts/qa seed    # copy the real store once
#   MACH_QA_INSTANCE=agent scripts/qa up
#   MACH_QA_INSTANCE=agent scripts/qa shoot before
#
# `seed` copies the owner's database so the agent instance has realistic mail
# and calendars without doing its own backfill or spending API quota. It
# refuses to overwrite an existing seeded store unless you pass --force.
#
# It copies mail, not credentials. Refresh tokens are in the Keychain, and a
# non-main instance addresses its own service — com.mach.mail.oauth.qa-<name>
# rather than com.mach.mail.oauth — so it cannot read or write the owner's.
# A seeded instance therefore starts with accounts and no credentials: every
# address reports "needs reauthorization" and nothing reaches Google. That is
# the intended state, and it is what stops a QA instance putting a Keychain
# password dialog on the owner's screen. See `auth::tokens::keychain_service`.
#
# Every command targets one instance's pid, so two instances can run at once
# and `shoot` never captures the wrong window.
#
# ---------------------------------------------------------------------------
#
# The binary runs directly rather than under `tauri dev`: the watcher rebuilds
# on every change, and each new unsigned binary re-prompts macOS for Keychain
# access. Vite still serves the frontend, so UI changes hot-reload into every
# running instance; only Rust changes need `down` && `up`.

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTANCE="${MACH_QA_INSTANCE:-main}"
QA_DIR="$REPO/.qa/$INSTANCE"
PIDFILE="$QA_DIR/mach.pid"
LOG="$QA_DIR/mach.log"
VITE_LOG="$REPO/.qa/vite.log"
BIN="$REPO/src-tauri/target/debug/mach"
REAL_DB="$HOME/Library/Application Support/com.mach.mail/mach.sqlite3"

# The owner's instance uses the OS app-data dir; every other instance is
# self-contained under .qa/<name>/data.
#
# The Keychain is the one thing that is global to the machine, so it is
# namespaced the same way: `auth::tokens::keychain_service` derives the service
# from MACH_DATA_DIR, and the value below is the same derivation so this script
# can say which namespace an instance is using. Only `main` names
# com.mach.mail.oauth, which is where the owner's refresh tokens are.
if [ "$INSTANCE" = "main" ]; then
  DATA_DIR=""
  DB="$REAL_DB"
  CONTROL=""
  KEYCHAIN_SERVICE="com.mach.mail.oauth"
else
  DATA_DIR="$QA_DIR/data"
  DB="$DATA_DIR/mach.sqlite3"
  # Written 0600 by `qa::write_endpoint` when the app starts. The `main`
  # instance has no MACH_DATA_DIR, so it never opens a port and there is
  # nothing here to read.
  CONTROL="$DATA_DIR/qa-control.json"
  SLUG="$(printf '%s' "$INSTANCE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/^-*//; s/-*$//')"
  [ -n "$SLUG" ] || SLUG="unnamed"
  KEYCHAIN_SERVICE="com.mach.mail.oauth.qa-$SLUG"
fi

mkdir -p "$QA_DIR"

die() { echo "qa[$INSTANCE]: $*" >&2; exit 1; }

instance_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid="$(cat "$PIDFILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# Window rect for THIS instance's pid. Returns "x y w h".
window_rect() {
  local pid; pid="$(instance_pid)" || return 1
  osascript <<APPLESCRIPT 2>/dev/null
tell application "System Events"
  set procs to (every process whose unix id is $pid)
  if procs is {} then return ""
  tell item 1 of procs
    if (count of windows) is 0 then return ""
    set p to position of window 1
    set s to size of window 1
    return ((item 1 of p) as string) & " " & ((item 2 of p) as string) & " " & ((item 1 of s) as string) & " " & ((item 2 of s) as string)
  end tell
end tell
APPLESCRIPT
}

# The window's CGWindowID, for capturing its own buffer without raising it.
window_id() {
  local pid; pid="$(instance_pid)" || return 1
  "$REPO/scripts/windowid.py" "$pid" 2>/dev/null
}

focus() {
  local pid; pid="$(instance_pid)" || return 0
  osascript -e "tell application \"System Events\" to set frontmost of (item 1 of (every process whose unix id is $pid)) to true" >/dev/null 2>&1 || true
}

ensure_vite() {
  curl -sf -o /dev/null http://localhost:1420 && return 0
  ( cd "$REPO" && nohup bun run dev >"$VITE_LOG" 2>&1 & )
  for _ in $(seq 1 30); do curl -sf -o /dev/null http://localhost:1420 && return 0; sleep 1; done
  die "vite did not come up; see $VITE_LOG"
}

cmd_seed() {
  [ "$INSTANCE" != "main" ] || die "seed is for agent instances; MACH_QA_INSTANCE=main is the real store"
  [ -f "$REAL_DB" ] || die "no store to copy from at $REAL_DB"
  mkdir -p "$DATA_DIR"
  if [ -f "$DB" ] && [ "${1:-}" != "--force" ]; then
    die "$DB already exists (pass --force to replace it)"
  fi
  # A live WAL means a plain cp can copy a torn database. sqlite3 .backup
  # takes a consistent snapshot while the owner's app keeps writing.
  sqlite3 "$REAL_DB" ".backup '$DB'"
  echo "seeded $DB from the real store"
  sqlite3 "$DB" "SELECT (SELECT count(*) FROM threads)||' threads, '||(SELECT count(*) FROM messages)||' messages, '||(SELECT count(*) FROM events)||' events';"
  echo
  echo "NOTE: credentials do not come with it. Tokens live in the Keychain, and"
  echo "      this instance addresses its own service ($KEYCHAIN_SERVICE),"
  echo "      which is empty. Every account above will report \"needs"
  echo "      reauthorization\" and no sync pass will reach Google. That is the"
  echo "      intended state: mail and calendars to look at, no credentials."
}

cmd_up() {
  if pid="$(instance_pid)"; then echo "already running (pid $pid)"; return 0; fi
  [ -x "$BIN" ] || die "no binary at $BIN — run: cd src-tauri && cargo build"
  [ -f "$REPO/.env.local" ] || die "no .env.local — the app would boot 'not configured'"
  [ "$INSTANCE" = "main" ] || [ -f "$DB" ] || echo "qa[$INSTANCE]: no seeded store; starting empty (try: qa seed)"

  # Same signature every build, so the Keychain stops treating each rebuild as
  # a new program and re-asking for the login password. A no-op until the
  # identity exists; see `scripts/sign --setup`.
  "$REPO/scripts/sign" >/dev/null 2>&1 || true

  ensure_vite
  # `exec` matters: without it the subshell stays alive as the parent and $!
  # is the *wrapper's* pid, not the app's — so every window lookup misses and
  # `shoot` silently degrades to a whole-screen capture. exec replaces the
  # subshell with the binary, so the recorded pid is the GUI process.
  (
    cd "$REPO" || exit 1
    set -a; . ./.env.local; set +a
    [ -n "$DATA_DIR" ] && export MACH_DATA_DIR="$DATA_DIR"
    exec "$BIN" >"$LOG" 2>&1
  ) &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 30); do instance_pid >/dev/null && break; sleep 1; done
  pid="$(instance_pid)" || die "the app did not start; see $LOG"

  # Wait for a window, not just a process.
  #
  # A debug build opening a large store takes appreciably longer to put a
  # window on screen than it takes to fork, and `up` used to return in between.
  # Anything that then tried to `shoot` got "no capturable window", which reads
  # as "the app is broken" rather than "ask again in a moment" — an agent
  # reported exactly that and concluded its own change had broken the build.
  local waited=0
  while [ "$waited" -lt 60 ]; do
    if [ -n "$(window_id)" ]; then
      echo "up (pid $pid)${DATA_DIR:+  data=$DATA_DIR}"
      return 0
    fi
    kill -0 "$pid" 2>/dev/null || die "the app exited during startup; see $LOG"
    sleep 1
    waited=$((waited + 1))
  done

  echo "up (pid $pid)${DATA_DIR:+  data=$DATA_DIR}"
  echo "qa[$INSTANCE]: running, but no window after ${waited}s — see $LOG" >&2
  keychain_notice
}

# Is a Keychain authorization dialog what is actually blocking?
#
# It is worth checking by name, because the symptom is otherwise inscrutable: a
# live process, no window, nothing in the log. A rebuilt binary has a new code
# signature, so the login keychain stops recognising it and macOS puts up a
# password prompt — which is a modal panel above the ordinary window layer,
# hence `--any-layer`. Nobody can guess that from "no window after 60s".
keychain_notice() {
  local agent
  for agent in $(pgrep -x SecurityAgent 2>/dev/null); do
    if "$REPO/scripts/windowid.py" "$agent" --any-layer >/dev/null 2>&1; then
      echo "qa[$INSTANCE]: a Keychain dialog is waiting on screen — approve it" >&2
      echo "               (\"Always Allow\" stops it asking for this build)" >&2
      return 0
    fi
  done
  return 1
}

cmd_down() {
  # The app removes its own token file when it shuts down cleanly, and a
  # SIGTERM is not a clean shutdown. A bearer token for a port that no longer
  # exists is only untidy rather than dangerous, and it should still not be
  # left lying in the tree.
  [ -n "$CONTROL" ] && rm -f "$CONTROL"
  if pid="$(instance_pid)"; then kill "$pid" 2>/dev/null || true; rm -f "$PIDFILE"; echo "stopped (pid $pid)";
  else echo "not running"; fi
}

cmd_shoot() {
  local name="${1:-shot}"
  local pid; pid="$(instance_pid)" || die "not running — try: qa up"
  local out="$QA_DIR/$name.png"

  # Captured by window id, which reads the window's own buffer: occluded,
  # behind other apps, on another Space — it does not matter, and nothing is
  # raised or focused. Raising the window to photograph it steals focus from
  # whoever is using the machine, and an agent iterating visually would do that
  # every few seconds.
  # Retry rather than fail on the first miss: a window that is merely still
  # being built is the common case, and a hard failure here is indistinguishable
  # from a genuinely broken app.
  local wid=""
  local tries=0
  while [ "$tries" -lt 20 ]; do
    wid="$(window_id)" || wid=""
    [ -n "$wid" ] && break
    sleep 1
    tries=$((tries + 1))
  done

  if [ -n "$wid" ]; then
    screencapture -x -o -l"$wid" "$out"
    echo "$out  (window $wid, pid $pid — not raised)"
    return 0
  fi

  # No window. Almost always the display is asleep or the app has not finished
  # launching. A black frame read as "the UI is broken" is worse than no frame.
  if pmset -g powerstate IODisplayWrangler 2>/dev/null | tail -1 | grep -qE '^ *[0-3] '; then
    die "the display is asleep or locked — wake it and retry"
  fi
  die "no capturable window for pid $pid (still launching?)"
}

cmd_state() {
  local pid; pid="$(instance_pid)" || pid=""
  echo "instance: $INSTANCE"

  # A process this script did not start is a process it cannot stop, and one
  # you can be looking at while `qa down && qa up` restarts a different one.
  # That is how two and a half hours of Rust changes stayed off screen: the
  # pidfile named one process and the window belonged to another.
  local strays=""
  for other in $(pgrep -x mach 2>/dev/null); do
    [ "$other" = "$pid" ] || strays="$strays $other"
  done
  if [ -n "$strays" ]; then
    echo "WARNING : untracked mach process(es)$strays — qa cannot stop these," >&2
    echo "          and one of them may be the window you are looking at." >&2
    for other in $strays; do
      echo "          pid $other started $(ps -p "$other" -o lstart= 2>/dev/null | xargs)" >&2
    done
  fi
  echo "process : ${pid:+running (pid $pid)}${pid:-NOT RUNNING}"
  echo "vite    : $(curl -sf -o /dev/null http://localhost:1420 && echo up || echo down)"
  echo "store   : $DB"
  echo "keychain: $KEYCHAIN_SERVICE"
  local rect; rect="$(window_rect 2>/dev/null)" || rect=""
  echo "window  : ${rect:-<none>}"
  [ -f "$DB" ] || { echo "db      : <none yet>"; return 0; }
  sqlite3 "$DB" <<'SQL'
.mode list
.headers off
SELECT 'accounts: ' || COALESCE(group_concat(email || ' [' || COALESCE(history_id,'backfilling') || ']', ', '), '<none>') FROM accounts;
SELECT 'threads : ' || count(*) FROM threads;
SELECT 'messages: ' || count(*) FROM messages;
SELECT 'labels  : ' || count(*) FROM labels;
SELECT 'events  : ' || count(*) || '  (' || COALESCE(min(date(start_ts/1000,'unixepoch')),'-') || ' .. ' || COALESCE(max(date(start_ts/1000,'unixepoch')),'-') || ')' FROM events;
SQL
}

# ---------------------------------------------------------------------------
# The control port
# ---------------------------------------------------------------------------
#
# One POST per verb, to a loopback port bound to 127.0.0.1 on an ephemeral
# port, carrying the bearer token the app wrote alongside it. Three verbs and
# no more; there is deliberately no way to ask the window to run code. See
# `src-tauri/src/qa/` for what a reader of that port could do and what stops
# them.
#
# python3 rather than curl and jq: it is what `windowid.py` already needs, and
# it reads the endpoint file, sends the request and pretty-prints the answer
# without a second tool having to be installed.
control() {
  local verb="$1" argument="${2:-}"
  [ -n "$CONTROL" ] || die "the control port only exists on a QA instance — try MACH_QA_INSTANCE=agent"
  instance_pid >/dev/null || die "not running — try: qa up"
  [ -f "$CONTROL" ] || die "no control port at $CONTROL (still starting? release build? see $LOG)"
  MACH_QA_VERB="$verb" MACH_QA_ARG="$argument" python3 - "$CONTROL" <<'PY'
import json, os, sys, urllib.error, urllib.request

endpoint = json.load(open(sys.argv[1]))
body = json.dumps({
    "verb": os.environ["MACH_QA_VERB"],
    "argument": os.environ["MACH_QA_ARG"],
}).encode()
request = urllib.request.Request(
    "http://127.0.0.1:%d/qa" % endpoint["port"],
    data=body,
    headers={
        "Authorization": "Bearer " + endpoint["token"],
        "Content-Type": "application/json",
    },
)
try:
    with urllib.request.urlopen(request, timeout=20) as response:
        answer = json.load(response)
except urllib.error.HTTPError as e:
    answer = {"ok": False, "error": "%d %s" % (e.code, e.read().decode("utf-8", "replace").strip())}
except OSError as e:
    answer = {"ok": False, "error": str(e)}

print(json.dumps(answer, indent=2, sort_keys=True))
sys.exit(0 if answer.get("ok") else 1)
PY
}

# A keymap token, delivered in-page. No OS input, no focus change.
#
# MACH_QA_INPUT=1 is the old path: real synthetic input, which raises the
# window and takes the keyboard from whoever is at the machine. It speaks
# cliclick rather than keymap tokens.
cmd_key() {
  [ $# -gt 0 ] || die "usage: qa key <binding>   e.g. 'mod+2', 'g i', c, '?'"
  if [ "${MACH_QA_INPUT:-}" = "1" ]; then
    command -v cliclick >/dev/null || die "cliclick is not installed (brew install cliclick)"
    instance_pid >/dev/null || die "not running"
    focus; sleep 0.6
    cliclick "$@"
    return
  fi
  control key "$1"
}

cmd_click() {
  [ $# -eq 1 ] || die "usage: qa click <css selector>   e.g. '[data-thread-id=\"41774\"]'"
  if [ "${MACH_QA_INPUT:-}" = "1" ]; then
    command -v cliclick >/dev/null || die "cliclick is not installed"
    local rect; rect="$(window_rect)" || die "cannot read the window rect"
    # shellcheck disable=SC2086
    set -- $rect "$1"
    local wx="$1" wy="$2" xy="$5"
    local rx="${xy%%,*}" ry="${xy##*,}"
    focus; sleep 0.5
    cliclick "c:$((wx + rx)),$((wy + ry))"
    echo "clicked window($rx,$ry)"
    return
  fi
  control click "$1"
}

cmd_ui() { control ui; }

cmd_logs() { tail -n "${1:-30}" "$LOG"; }

# Rebuild, then restart onto what was just built.
#
# The rebuild is the point. The frontend hot-reloads through Vite, so after a
# `git pull` the window looks current while the Rust half is whatever was
# running before — a mismatched pair that fails in ways that look like ordinary
# bugs. It has cost this project a whole afternoon twice: once chasing a
# calendar save path that was already fixed, once with preferences silently
# having nowhere to persist to because the migration was not in the process.
#
# `cargo build` is incremental, so this is a second or two when nothing changed.
cmd_restart() {
  echo "building…"
  ( cd "$REPO/src-tauri" && cargo build 2>&1 | grep -E '^(error|warning)' ) && {
    echo "qa[$INSTANCE]: build reported problems — not restarting" >&2
    return 1
  }
  cmd_down
  cmd_up
}

case "${1:-}" in
  up)      shift; cmd_up "$@" ;;
  down)    shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  seed)  shift; cmd_seed "$@" ;;
  shoot) shift; cmd_shoot "$@" ;;
  state) shift; cmd_state "$@" ;;
  key)   shift; cmd_key "$@" ;;
  click) shift; cmd_click "$@" ;;
  ui)    shift; cmd_ui "$@" ;;
  logs)  shift; cmd_logs "$@" ;;
  *) sed -n '4,58p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ; exit 1 ;;
esac
