#!/usr/bin/env bash
set -euo pipefail
#
# scripts/cargo-target-dir — where cargo actually put the binary.
#
# `src-tauri/target` is only the answer in the main checkout. Every agent
# worktree gets a `.cargo/config.toml` from `bin/worktree-setup` pointing
# `build.target-dir` at the *parent's* cache, so a worktree does not recompile
# the dependency graph for a ten-line change. The consequence is that
# `$REPO/src-tauri/target/debug/mach` does not exist in a worktree, and every
# script that hardcoded it broke there:
#
#   - `scripts/qa up` said "no binary — run cargo build", and running it did not
#     help, because cargo put the result somewhere else. Agents worked around it
#     by hand-symlinking the parent's target dir in and removing it afterwards.
#   - `scripts/sign` silently skipped every target (`[ -f "$binary" ] || continue`),
#     so worktree builds were never signed and the Keychain asked again.
#
# Resolution order, cheapest first, and it stops at the first answer:
#
#   1. $CARGO_TARGET_DIR — cargo's own override, and it outranks config files.
#   2. build.target-dir in $REPO/.cargo/config.toml or
#      $REPO/src-tauri/.cargo/config.toml — where a human or `worktree-setup`
#      would write it.
#   3. $REPO/src-tauri/target — the plain checkout.
#
# If the answer has no `debug` directory and cargo is on PATH, ask cargo
# instead: `cargo metadata` reads every config source there is, including ones
# above the repo, and is the authority when the guesses miss. It costs a few
# hundred milliseconds, which is why it is last rather than first.
#
# Usage: scripts/cargo-target-dir [repo-root]

REPO="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# `target-dir = "..."` under a `[build]` table. Deliberately literal: these
# files are generated by `bin/worktree-setup` or written by hand, and a TOML
# parser for one key is not worth a dependency the script does not otherwise
# have.
from_config() {
  local file="$1"
  [ -f "$file" ] || return 1
  python3 - "$file" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
section = None
for line in text.splitlines():
    line = line.split("#", 1)[0].strip()
    if line.startswith("[") and line.endswith("]"):
        section = line[1:-1].strip()
        continue
    if section != "build":
        continue
    match = re.match(r'target-dir\s*=\s*["\'](.+)["\']\s*$', line)
    if match:
        print(match.group(1))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

resolve() {
  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    echo "$CARGO_TARGET_DIR"
    return 0
  fi

  local config
  for config in "$REPO/.cargo/config.toml" "$REPO/src-tauri/.cargo/config.toml"; do
    local found
    if found="$(from_config "$config" 2>/dev/null)" && [ -n "$found" ]; then
      # A relative target-dir is relative to the file's own directory.
      case "$found" in
        /*) echo "$found" ;;
        *)  echo "$(cd "$(dirname "$config")/.." && pwd)/$found" ;;
      esac
      return 0
    fi
  done

  echo "$REPO/src-tauri/target"
}

answer="$(resolve)"

if [ ! -d "$answer/debug" ] && command -v cargo >/dev/null 2>&1; then
  authoritative="$(
    cd "$REPO/src-tauri" 2>/dev/null &&
      cargo metadata --format-version 1 --no-deps 2>/dev/null |
      python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])' 2>/dev/null
  )" || authoritative=""
  [ -n "$authoritative" ] && answer="$authoritative"
fi

echo "$answer"
