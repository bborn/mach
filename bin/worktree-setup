#!/usr/bin/env bash
set -euo pipefail
#
# bin/worktree-setup
#
# Make a freshly-created git worktree behave like a normal checkout.
#
# TaskYou runs each task in its own worktree, which is clean: no
# node_modules, no gitignored secrets, and no Rust build cache. Without
# this, an agent picking up a feedback task cannot build, cannot test, and
# cannot authorize — so it would report a green diff it never actually ran.
#
# Environment provided by TaskYou: WORKTREE_TASK_ID, WORKTREE_PORT,
# WORKTREE_PATH. All optional here; the script also works standalone.
#
# Safe to re-run.

WORKTREE_DIR="${WORKTREE_PATH:-$(git rev-parse --show-toplevel)}"
cd "$WORKTREE_DIR"

# The main checkout this worktree was created from. Gitignored files can
# only come from there — they are on this machine and nowhere else.
#
# Derive it from the common git dir rather than parsing `git worktree list`:
# that listing is order-dependent and its paths break under `awk '{print $1}'`
# the moment one contains a space. When it misresolved to the worktree itself,
# the generated config below pointed the worktree's target dir at the worktree,
# and that single checkout grew a 66G build tree of its own.
PARENT_DIR="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

echo "==> Setting up Mach worktree${WORKTREE_TASK_ID:+ for task $WORKTREE_TASK_ID}"
echo "    worktree: $WORKTREE_DIR"
echo "    parent:   $PARENT_DIR"

# --- Base commit -------------------------------------------------------------
# The harness branches a new worktree from `origin/main`; the branch reflog
# says so in as many words ("Created from origin/main"). That is a
# remote-tracking ref, and on this machine it does not track anything:
#
#   * Nothing here runs `git fetch origin`. Every entry in `origin/main`'s
#     reflog is "update by push", so the ref only moves when something is
#     pushed *from* this machine.
#   * Commits that land on GitHub come back down with
#     `git pull https://github.com/bborn/mach.git main` — a pull by URL. Git
#     treats a URL as an anonymous remote: it fast-forwards the checked-out
#     branch and writes FETCH_HEAD, and having no refspec for
#     refs/remotes/origin/*, it leaves `origin/main` exactly where it was.
#
# On 2026-08-13 those two together left `origin/main` 44 commits behind `main`.
# Four agents in a row were branched onto a base that predated the files they
# had been asked to edit, and nothing on screen said so — they found out by
# reporting that files on main did not exist, and the work was thrown away.
#
# So the contract is: a worktree starts from the tip of main as this machine
# will actually merge it — whichever of `main` and a freshly fetched
# `origin/main` is ahead, preferring `main` when the two have diverged, because
# unpushed merges land there first and that is what this branch gets merged
# into. The base is printed, here and again at the end, so that a wrong one
# shows up in the first minute rather than after the work is done.
BASE_SUMMARY=""
if [ "$PARENT_DIR" = "$WORKTREE_DIR" ]; then
  BASE_SUMMARY="base:     $(git rev-parse --short HEAD) — main checkout, left alone"
  echo "    ${BASE_SUMMARY}"
else
  # Explicit refspec rather than `git fetch origin main`: this must update the
  # remote-tracking ref, which is the whole point, and not rely on git's
  # opportunistic update of it.
  if ! git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main" 2>/dev/null; then
    echo "!!! Could not fetch origin — the base below may be out of date."
  fi

  # Whichever of the two is a descendant of the other. A ref that is missing,
  # or behind, or diverged never wins.
  BASE_REF=""
  BASE_SHA=""
  for ref in refs/heads/main refs/remotes/origin/main; do
    sha="$(git rev-parse --verify --quiet "$ref" || true)"
    [ -n "$sha" ] || continue
    if [ -z "$BASE_SHA" ] || git merge-base --is-ancestor "$BASE_SHA" "$sha"; then
      BASE_SHA="$sha"
      BASE_REF="$ref"
    fi
  done

  if [ -z "$BASE_SHA" ]; then
    echo "!!! Found neither main nor origin/main. Leaving this worktree where it is."
    BASE_SUMMARY="base:     $(git rev-parse --short HEAD) — UNVERIFIED, no main branch to compare against"
  else
    HEAD_SHA="$(git rev-parse HEAD)"
    BEHIND="$(git rev-list --count "HEAD..$BASE_SHA")"
    echo "    base:     $(git rev-parse --short "$BASE_SHA") ($BASE_REF) $(git log -1 --format=%s "$BASE_SHA")"

    if [ "$HEAD_SHA" = "$BASE_SHA" ]; then
      BASE_SUMMARY="base:     $(git rev-parse --short "$BASE_SHA") ($BASE_REF) — already current"
    elif [ -n "$(git status --porcelain)" ]; then
      echo "!!! This worktree is $BEHIND commits behind that base and has uncommitted"
      echo "    changes, so it is being left alone. Rebase it yourself before you trust"
      echo "    anything you build here."
      BASE_SUMMARY="base:     $(git rev-parse --short HEAD) — STALE, $BEHIND commits behind $BASE_REF"
    elif git merge --ff-only --quiet "$BASE_SHA" 2>/dev/null; then
      echo "==> Moved this worktree forward $BEHIND commits (was $(git rev-parse --short "$HEAD_SHA"))"
      BASE_SUMMARY="base:     $(git rev-parse --short "$BASE_SHA") ($BASE_REF) — fast-forwarded $BEHIND commits"
    else
      echo "!!! This worktree has commits of its own and cannot fast-forward onto that"
      echo "    base. Leaving it alone — rebase onto $BASE_REF before you trust it."
      BASE_SUMMARY="base:     $(git rev-parse --short HEAD) — DIVERGED from $BASE_REF"
    fi
  fi
fi

# --- Google OAuth credentials ------------------------------------------------
# Without these the app boots but reports "not configured", so anything
# touching auth, sync or the API clients is untestable.
if [ -f "$PARENT_DIR/.env.local" ]; then
  cp "$PARENT_DIR/.env.local" "$WORKTREE_DIR/.env.local"
  echo "==> Copied .env.local (Google OAuth client)"
else
  echo "!!! No .env.local in the parent checkout."
  echo "    The app will boot but report 'not configured'."
  echo "    Anything touching auth, sync or the Google clients cannot be tested."
fi

# --- Frontend ----------------------------------------------------------------
if command -v bun >/dev/null 2>&1; then
  echo "==> bun install"
  bun install --silent
else
  echo "!!! bun is not on PATH — the frontend cannot be built."
  echo "    A GUI-launched parent inherits launchd's PATH, not your shell's."
fi

# --- Rust --------------------------------------------------------------------
# Share the parent's target directory. A fresh worktree would otherwise
# rebuild every dependency from scratch (several minutes, ~2GB) for what is
# usually a ten-line change. CARGO_TARGET_DIR is honoured by every cargo
# invocation, including the one tauri spawns.
# Guard both ways. Pointing a worktree's target dir at itself is the failure
# that filled the disk, and gating on the parent's target already existing meant
# a freshly-cleaned parent silently opted every new worktree back into its own
# full build tree. Create the directory instead of skipping the config.
if [ "$PARENT_DIR" = "$WORKTREE_DIR" ]; then
  echo "==> Main checkout, not a worktree — leaving cargo target dir alone"
elif [ ! -d "$PARENT_DIR/src-tauri" ]; then
  echo "!!! Could not locate the parent checkout at $PARENT_DIR — not sharing the target dir."
else
  mkdir -p "$PARENT_DIR/src-tauri/target" "$WORKTREE_DIR/.cargo"
  cat > "$WORKTREE_DIR/.cargo/config.toml" <<EOF
# Generated by bin/worktree-setup.
#
# Point at the parent checkout's build cache so this worktree does not
# recompile the whole dependency graph. Cargo locks the target directory,
# so concurrent builds wait rather than corrupt each other.
[build]
target-dir = "$PARENT_DIR/src-tauri/target"

# No incremental cache from a worktree build.
#
# This is the line that stops the disk filling. Measured on a clean target
# directory, one one-line rebuild of \`lib.rs\`:
#
#     as configured           +203MB   7.2s
#     CARGO_INCREMENTAL=0      +17MB  15.6s
#
# Twelve times the growth for eight seconds, and the eight seconds are the
# part nobody here is waiting on — an agent build is one-shot and unattended.
#
# The cache is also nearly useless in this arrangement. Every worktree shares
# the one target directory above, so fifteen checkouts at fifteen different
# commits each write their own ~190MB session into it, and the next build in
# that directory is somebody else's code at somebody else's commit. Full price,
# almost no hits. \`src-tauri/target\` was created on 2026-08-07 and reached
# **106GB** by 2026-08-22 — about 7GB a day — until it filled a 926GB disk.
#
# The main checkout is deliberately left alone: that is where a person edits
# and rebuilds in a loop, and 7s against 16s is worth 190MB there.
incremental = false
EOF
  echo "==> Sharing the parent's cargo target dir (skips a full rebuild, no incremental cache)"
fi

echo "==> Warming the Rust build"
( cd src-tauri && cargo check --all-targets 2>&1 | tail -2 ) || {
  echo "!!! cargo check failed — see above before starting work."
}

echo
echo "==> Ready."
echo "    $BASE_SUMMARY"

cat <<'EOF'

    Tests:      cd src-tauri && cargo test     ·     bunx vitest run
    Build:      bun run build
    Run it:     set -a && source .env.local && set +a && bun run tauri dev

    Note: `tauri dev` rebuilds the Rust binary on every change, and each
    new unsigned binary triggers a fresh macOS Keychain prompt. For a long
    session, run `bun run dev` and launch the built binary directly instead
    — the frontend still hot-reloads.
EOF
