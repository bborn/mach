{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Mirrors the `@` alias already configured in vite.config.ts */
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true,
    /*
     * The reference plugins under `plugins/` are plain ES modules with no build
     * step — that is the authoring story — and `examples.test.ts` imports them
     * as published so the tests exercise the real files rather than a copy.
     */
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `tsconfig.node.json` covers the Vite config and is checked separately —
   * `bun run build` runs both. It used to be a project *reference*, which
   * stopped working the moment the config started importing a file out of
   * `src`: a referenced project claims the files it lists, and this one then
   * wants a built `.d.ts` for a source file it can already see.
   */
  "include": ["src", "plugins"]
}
