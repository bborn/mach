{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Mirrors the `@` alias already configured in vite.config.ts */
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true,
    /*
     * The reference plugins under `plugins/` are plain ES modules with no build
     * step — that is the authoring story — and `examples.test.ts` imports them
     * as published so the tests exercise the real files rather than a copy.
     */
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "plugins"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
